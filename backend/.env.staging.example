# RSHD Staging environment template — copy to server .env (never commit real .env)
# Replace example.com hostnames and fill secrets via secrets manager.

APP_NAME="RSHD Staging"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Amman
APP_URL=https://staging-api.example.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rshd_staging
DB_USERNAME=rshd_staging
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=rshd_staging_

# Mail — use staging-only inbox (Mailtrap, SES sandbox, etc.)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply-staging@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=staging-api.example.com

# Staging seed password (used only when running StagingDataSeeder)
STAGING_SEED_PASSWORD=

# Video — Bunny Stream (staging library / zone)
VIDEO_PROVIDER=bunny
VIDEO_SIGNED_PLAYBACK=true
VIDEO_PLAYBACK_TTL=600
VIDEO_PLAYBACK_SIGNING_KEY=
VIDEO_SECURE_SCREEN=false
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_READ_ONLY_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_STREAM_TOKEN_IP_BINDING=false
BUNNY_STREAM_PLAYBACK_MODE=embed
BUNNY_STREAM_EMBED_TOKEN_KEY=
BUNNY_STREAM_REQUIRE_EMBED_TOKEN=true
BUNNY_STREAM_LOCAL_FALLBACK=false

# Files — Bunny Storage (staging zone)
BUNNY_FILES_TOKEN_KEY=
BUNNY_FILES_CDN_HOSTNAME=
BUNNY_FILES_STORAGE_ZONE=
BUNNY_FILES_STORAGE_PASSWORD=
BUNNY_FILES_STORAGE_HOSTNAME=
BUNNY_FILES_DOWNLOAD_TTL=600
FILES_SIGNED_DOWNLOAD=true

# OAuth — staging client IDs (optional)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
